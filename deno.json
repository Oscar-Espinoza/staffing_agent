{
  "imports": {
    "zod": "npm:zod@4.5.4",
    "@std/assert": "jsr:@std/assert@1"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "fmt": {
    "include": [
      "src/",
      "deno.json"
    ],
    "lineWidth": 100,
    "singleQuote": true,
    "semiColons": true
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --env-file src/index.ts",
    "typecheck": "deno check src/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno fmt --check && deno lint && deno task typecheck",
    "start": "deno run --allow-net --allow-env src/index.ts"
  },
  "deploy": {
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./src/index.ts"
    }
  }
}
